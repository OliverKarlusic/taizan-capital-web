# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local capture output from dev tooling
/.captures/

# hero masters are large; keep source video out of git
public/media/hero/*.mp4

# production build output (kept separate from the dev server cache)
/.next-build/

# encoded renditions are build output, regenerate with scripts/encode-media.mjs
public/media/hero/*-854.mp4
public/media/hero/*-1280.mp4
public/media/hero/*-1920.mp4
